{
  "name": "paradox",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @paradox/web",
    "build": "npm run build --workspace @paradox/web",
    "lint": "npm run lint --workspace @paradox/web",
    "typecheck": "npm run typecheck --workspace @paradox/web",
    "contract:build": "stellar contract build --locked",
    "test:commitment": "node --experimental-strip-types --test apps/web/src/lib/commitment.test.ts",
    "check": "sh scripts/check.sh"
  }
}
